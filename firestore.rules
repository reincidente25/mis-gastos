rules_version = '2';

// Reglas de seguridad para Mis Gastos (presupuesto compartido por hogar).
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    // ¿El usuario es miembro del hogar?
    function esMiembro(hogarId) {
      return autenticado()
        && request.auth.uid in get(/databases/$(database)/documents/hogares/$(hogarId)).data.miembros;
    }

    // Perfil de cada usuario: solo el dueño.
    match /usuarios/{uid} {
      allow read, write: if autenticado() && request.auth.uid == uid;
    }

    // Documento del hogar.
    match /hogares/{hogarId} {
      // Lectura abierta a autenticados (permite buscar por código para unirse).
      allow read: if autenticado();

      // Crear: el creador debe quedar como miembro.
      allow create: if autenticado()
        && request.auth.uid in request.resource.data.miembros;

      // Actualizar: debe seguir siendo miembro al terminar
      // (permite unirse agregándose a sí mismo, y editar siendo miembro).
      allow update: if autenticado()
        && request.auth.uid in request.resource.data.miembros;

      allow delete: if false;

      // Subcolecciones con los datos financieros: solo miembros.
      match /{documento=**} {
        allow read, write: if esMiembro(hogarId);
      }
    }
  }
}
